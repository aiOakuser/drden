# ── Local Development (.env) ─────────────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.
#
# cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ───────────────────────────────────────────────────────────
# SQLite (default for local)
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Google OAuth (Gmail / “Continue with Google” login) ─────────────────
# Required for the “Continue with Google” button on the login page.
# Get credentials from https://console.cloud.google.com/ → APIs & Services → Credentials
# Create OAuth 2.0 client (Web application) and add Authorized redirect URI:
#   Local: http://127.0.0.1:8005/auth/complete/google-oauth2/
#   Local: http://localhost:8005/auth/complete/google-oauth2/
# See docs/GOOGLE_GMAIL_LOGIN.md for full setup.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For local HTTP only (runserver):
# SOCIAL_AUTH_REDIRECT_IS_HTTPS=False
# Require Gmail/Google login only (disables username/password and passkeys):
# GOOGLE_LOGIN_MANDATORY=True

# ── OpenAI (AI Chat / Designer AI / Site Builder) ─────────────────────
# Required for streaming chat and intelligent AI responses.
# Get your key from https://platform.openai.com/api-keys
#
# Local dev: put in .env (this file is gitignored)
# Production: set OPENAI_API_KEY as an environment variable in your
#   Coolify/VPS service config (never in code or committed files)
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
