# ── Template: align with .env.production ───────────────────────────────────
# Copy to `.env` for local dev or use this checklist on your host (Coolify, etc.).
# Never commit real secrets. Only `.env.example` belongs in git.

# ── Environment ───────────────────────────────────────────────────────────
DEBUG=True
# ENV=development
# Production:
# DEBUG=False
# ENV=production

# ── Django core ───────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Public URLs / canonical redirects ─────────────────────────────────────
BASE_URL_LOCAL=http://127.0.0.1:8000
BASE_URL_SERVER=
CANONICAL_HOST=
CANONICAL_REDIRECT_HOSTS=
CANONICAL_DOMAIN_REDIRECT_ENABLED=false
CANONICAL_REDIRECT_SCHEME=https
COMMUNITY_FORUM_URL=
FIXED_HOMEPAGE=no

# ── Database ──────────────────────────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite:///db.sqlite3
# Production-style PostgreSQL (example placeholders — use one URL or split vars):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# ── Storage (media / static) ──────────────────────────────────────────────
STORAGE=server
# set to "s3" when ready
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ── Redis (optional) ────────────────────────────────────────────────────────
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAILS=
PRETTYPEARL_CONTACT_EMAIL=

DROPBOX_ACCESS_TOKEN=

# ── Google OAuth (Gmail / “Continue with Google”) ─────────────────────────
# docs/GOOGLE_GMAIL_LOGIN.md — redirect: https://YOUR_DOMAIN/auth/complete/google-oauth2/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_REDIRECT_IS_HTTPS=False
# GOOGLE_LOGIN_MANDATORY=False

# ── OpenAI (Designer AI chat widget + streaming API + Site Builder AI) ─────
# Create a key at https://platform.openai.com/api-keys — paste below (no quotes).
OPENAI_API_KEY=
# Chat/completions model id (must exist on your account / endpoint).
OPENAI_MODEL=gpt-4o-mini
# Read timeout (seconds) for OpenAI HTTP client; streaming needs a generous window.
# Behind nginx, also raise proxy_read_timeout above OPENAI_TIMEOUT.
OPENAI_TIMEOUT=300
# Multi-org accounts only — https://platform.openai.com/settings/organization
# OPENAI_ORGANIZATION=org-...
# Azure OpenAI or compatible proxy only — omit for api.openai.com
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
DESIGNER_AI_AUTO_POPUP=True

# ── Stripe (designer membership — credit/debit cards + Link) ───────────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Create recurring Prices for each tier, then paste price_… ids below.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_PERSONAL_WEBSITE_MONTHLY=
STRIPE_PRICE_PERSONAL_WEBSITE_YEARLY=
STRIPE_PRICE_PREMIUM_STUDIO_MONTHLY=
STRIPE_PRICE_PREMIUM_STUDIO_YEARLY=

# ── Brand / misc ──────────────────────────────────────────────────────────
# GDH_INSTAGRAM_URL=https://www.instagram.com/globaldesignerhub/
