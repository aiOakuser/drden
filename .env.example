# Example environment configuration (SAFE TO COMMIT)
# Copy to `.env.local` for local dev, or set these in your hosting provider (Coolify/Docker/etc).
#
# IMPORTANT: Never commit real secrets (DB passwords, OAuth secrets, API keys).
#
# --- Core ---
ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret

# Comma-separated hosts/origins
ALLOWED_HOSTS=127.0.0.1,localhost,globaldesignerhub.com,www.globaldesignerhub.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://globaldesignerhub.com,https://www.globaldesignerhub.com

BASE_URL_LOCAL=http://127.0.0.1:8000
BASE_URL_SERVER=https://globaldesignerhub.com

CANONICAL_DOMAIN_REDIRECT_ENABLED=true
CANONICAL_HOST=globaldesignerhub.com
CANONICAL_REDIRECT_HOSTS=www.globaldesignerhub.com
CANONICAL_REDIRECT_SCHEME=https

COMMUNITY_FORUM_URL=https://globaldesignerhub.com/community
FIXED_HOMEPAGE=no

# --- Database ---
# Prefer DATABASE_URL in production (recommended).
# Replace USER/PASSWORD/HOST with real values, or remove when using DB_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/designer_db

# Or provide individual DB_* vars instead:
DB_HOST=HOST
DB_NAME=designer_db
DB_PASSWORD=PASSWORD
DB_PORT=5432
DB_USER=postgres

# Coolify-linked Postgres service vars are also supported:
POSTGRES_HOST=HOST
POSTGRES_DB=designer_db
POSTGRES_PASSWORD=PASSWORD
POSTGRES_PORT=5432
POSTGRES_USER=postgres

# --- Static/Media storage ---
# USE_S3_MEDIA enables S3-backed media uploads (recommended for production uploads).
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=designer-static-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4

# --- Redis / caching ---
USE_REDIS=False
REDIS_URL=redis://designer-redis:6379/1

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAILS=admin@example.com
PRETTYPEARL_CONTACT_EMAIL=admin@example.com

# --- OAuth / Third-party ---
DROPBOX_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=${GOOGLE_CLIENT_ID}
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=${GOOGLE_CLIENT_SECRET}
SOCIAL_AUTH_REDIRECT_IS_HTTPS=True

# --- OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

